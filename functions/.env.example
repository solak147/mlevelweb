# 綠界（ECPay）信用卡一次付清。
#
# ECPAY_API_URL 指向 payment-stage.ecpay.com.tw（測試環境）時，下面三個欄位可以留空，
# 會沿用綠界官方公開的測試特店（2000132）方便本機跑完整流程。
#
# 一旦把 ECPAY_API_URL 換成正式結帳網址
# （https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5），
# 這三個欄位就「必填、且不得是綠界公開的測試金鑰」，否則 getEcpayConfig() 會直接拋錯。
# 原因：HashKey/HashIV 是驗證付款回呼（CheckMacValue）的唯一憑據，用公開金鑰跑正式流量
# 等於任何人都能偽造 /notify、自己發一組授權金鑰出來。
ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_MERCHANT_ID=3002607
# ECPAY_HASH_KEY / ECPAY_HASH_IV 不放在這裡 —— 它們是驗證付款回呼的唯一憑據，
# 由 Secret Manager 保管（見 functions/index.js 的 defineSecret）：
#   firebase functions:secrets:set ECPAY_HASH_KEY
#   firebase functions:secrets:set ECPAY_HASH_IV
# 本機 emulator 則讀 functions/.secret.local。
# 注意：同一個 key 不能同時出現在這個檔案和 Secret Manager，否則部署會被拒絕。
# 綠界回呼（ReturnURL / OrderResultURL）的 base URL，留空時自動用 request host 推導
ECPAY_CALLBACK_BASE_URL=https://asia-east1-mlevel-f575a.cloudfunctions.net/ecpayApi

# 程式壓縮檔在 Cloud Storage 的位置。發布新版只要覆蓋這個物件，
# /download 會即時讀取，不用改設定也不用重新部署。
MLEVEL_STORAGE_BUCKET=
MLEVEL_STORAGE_OBJECT=mlevel.zip

# 舊的固定下載連結。只在 Storage 上找不到上面那個物件時當退路使用。
MLEVEL_DOWNLOAD_URL=

# 允許付款後導回的額外網域（逗號分隔）。
# localhost 與 <專案 ID>.web.app / .firebaseapp.com 已預設允許，綁自訂網域後要加在這裡。
MLEVEL_ALLOWED_REDIRECT_HOSTS=

# 「一把金鑰一次只能一個人用」的舊版阻擋開關。
# false（預設）：舊版桌面程式仍可用 /verify 啟動，但 /verify 不佔席位，
#   所以舊版可以同時開好幾份 —— 這段期間限制形同沒有。
# true：/verify 回 426 要求使用者更新。等新版（會打 /session/acquire）鋪開後再打開。
MLEVEL_REQUIRE_SESSION=false

# App Check 強制模式。false（預設）只記錄不阻擋，方便先觀察 Console 的 App Check 報表；
# 確認正常流量都已驗證後改成 true，/create、/order、/lookup 就會擋掉沒有有效 token 的請求。
# （/notify、/result、/verify、/download 一律不驗，它們帶不了 token。）
MLEVEL_APPCHECK_ENFORCE=false
