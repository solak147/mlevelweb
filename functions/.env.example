# 綠界（ECPay）信用卡一次付清。留空時會使用綠界官方公開測試特店（2000132）。
# 正式上線務必填入自己的特店資料，並把 ECPAY_API_URL 換成正式結帳網址。
ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 綠界回呼（ReturnURL / OrderResultURL）的 base URL，留空時自動用 request host 推導
ECPAY_CALLBACK_BASE_URL=https://asia-east1-YOUR_FIREBASE_PROJECT_ID.cloudfunctions.net/ecpayApi

# 付款成功後顯示給使用者的程式下載連結
MLEVEL_DOWNLOAD_URL=

# 允許付款後導回的額外網域（逗號分隔）。
# localhost 與 <專案 ID>.web.app / .firebaseapp.com 已預設允許，綁自訂網域後要加在這裡。
MLEVEL_ALLOWED_REDIRECT_HOSTS=
