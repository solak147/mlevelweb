# 後端 Cloud Functions（ecpayApi）的 base URL
# 正式：https://asia-east1-mlevel-f575a.cloudfunctions.net/ecpayApi
# 本機 emulator：http://127.0.0.1:5001/mlevel-f575a/asia-east1/ecpayApi
VITE_ECPAY_API_URL=https://asia-east1-mlevel-f575a.cloudfunctions.net/ecpayApi

# Firebase App Check（reCAPTCHA Enterprise）。留空時前端不啟用 App Check，
# 後端 ecpayApi 只會在 log 記一筆、不會擋（見 functions 的 MLEVEL_APPCHECK_ENFORCE）。
# site key 來自 Firebase Console → App Check → 註冊網頁 App 時建立的 reCAPTCHA Enterprise 金鑰。
VITE_FIREBASE_APPCHECK_SITE_KEY=
# 本機開發用的 debug token（只在 vite dev 生效，要先貼到 Console → App Check → 管理 debug token）。
# 留空時 SDK 會自己在 console 印一組出來，複製去 Console 註冊即可。
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
